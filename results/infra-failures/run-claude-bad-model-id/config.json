    "job_name": "run-claude",
    "n_attempts": 3,
    "n_concurrent_trials": 3,
    "agents": [
        {
            "name": "claude-code",
            "model_name": "anthropic/claude-opus-5.5",
            "kwargs": {
                "reasoning_effort": "max"
