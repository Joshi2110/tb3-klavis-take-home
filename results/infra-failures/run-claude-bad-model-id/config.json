            "env": {
                "CLAUDE_FORCE_OAUTH": "****",
                "CLAUDE_CODE_OAUTH_TOKEN": "${CLAUDE_CODE_OAUTH_TOKEN}",
                "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000"
            }
        }
    ],
    "tasks": [
        {
            "path": "tasks/electric-orbit-raising"
        }
    ]
}